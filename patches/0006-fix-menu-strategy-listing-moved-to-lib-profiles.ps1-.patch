From 5d8d4a704c7258d29e7ff48d10f51bbaa72c67c6 Mon Sep 17 00:00:00 2001
From: "qwen.ai[bot]" <qwenlm-intl@service.alibaba.com>
Date: Thu, 22 Oct 2026 02:22:33 +0000
Subject: [PATCH 6/8] fix(menu): strategy listing moved to lib/profiles.ps1
 (Get-ChildItem); cmd glob under chcp 65001 silently returned no files

---
 src/lib/profiles.ps1 | 59 ++++++++++++++++++++++++++++++++++++++++++++
 src/menu.bat         | 24 ++++++++++++------
 2 files changed, 75 insertions(+), 8 deletions(-)
 create mode 100644 src/lib/profiles.ps1

diff --git a/src/lib/profiles.ps1 b/src/lib/profiles.ps1
new file mode 100644
index 0000000..29165cf
--- /dev/null
+++ b/src/lib/profiles.ps1
@@ -0,0 +1,59 @@
+﻿# ============================================================
+#  ZapretEye (zeye) - list engine strategy profiles
+#  Prints one line per *.bat strategy found in zapret-engine\:
+#      <file-name>.bat|<arguments parsed from the winws.exe line>
+#  Used by menu.bat (:pickstrategy) and zeye.bat (profiles).
+#
+#  Why a PS helper instead of a cmd "for %%F in (...)" loop:
+#  cmd's globbing silently yields zero iterations when the console
+#  codepage is 65001 (chcp) on some Windows builds, which made the
+#  picker show ".bat стратегии не найдены в движке" even though the
+#  files were on disk. Get-ChildItem (the same call check.ps1 uses)
+#  is immune to that.
+# ============================================================
+
+$ErrorActionPreference = 'Stop'
+try {
+    $srcDir = Split-Path -Parent $MyInvocation.MyCommand.Path   # <root>\src\lib
+    $root   = Split-Path -Parent (Split-Path -Parent $srcDir)   # <root>
+    $engine = Join-Path $root 'zapret-engine'
+
+    if (-not (Test-Path -LiteralPath $engine)) { exit 0 }
+
+    # helper scripts that ship inside the release but are not strategies
+    $skip = @('service.bat', 'uninstall_service.bat', 'update.bat', 'check.bat',
+              'restart.bat', 'run_fast.bat', 'run_general.bat')
+
+    foreach ($f in (Get-ChildItem -LiteralPath $engine -Filter '*.bat' -File | Sort-Object Name)) {
+        if ($skipPrefixes | Where-Object { $f.Name.ToLower().StartsWith($_) }) { continue }
+        $argLine = ''
+        try {
+            # Flowseal profiles invoke the engine like:
+            #   winws.exe --filter ... --strategy ...
+            # take the first such line and strip everything up to the exe name.
+            $line = Select-String -LiteralPath $f.FullName -Pattern 'winws(\.exe)?' -SimpleMatch:$false |
+                    Select-Object -First 1
+            if ($line) {
+                $t = $line.Line.Trim()
+                $i = $t.ToLower().IndexOf('winws')
+                if ($i -ge 0) {
+                    $rest = $t.Substring($i)
+                    $j = $rest.IndexOf('.exe')
+                    if ($j -ge 0) { $rest = $rest.Substring($j + 4) } else { $rest = $rest.Substring(5) }
+                    $argLine = $rest.Trim().TrimStart('"').Trim()
+                    # drop a trailing redirection/rem part for readability
+                    foreach ($cut in @('>', '^>', 'rem ', 'pause')) {
+                        $k = $argLine.IndexOf($cut, [System.StringComparison]::OrdinalIgnoreCase)
+                        if ($k -gt 0) { $argLine = $argLine.Substring(0, $k).Trim() }
+                    }
+                }
+            }
+        } catch { $argLine = '' }
+        Write-Output ($f.Name + '|' + $argLine)
+    }
+    exit 0
+}
+catch {
+    Write-Error $_
+    exit 1
+}
diff --git a/src/menu.bat b/src/menu.bat
index e1e1070..1965105 100644
--- a/src/menu.bat
+++ b/src/menu.bat
@@ -76,6 +76,16 @@ rem ---- first run: pick a strategy (it becomes the automatic one)
 if not "!DSTRAT!"=="" goto :launch
 goto :pickstrategy
 
+rem ============================================================
+rem  Strategy picker. NOTE: the old implementation used a cmd
+rem  "for %%F in ("%ZEYE_ENGINE%\*.bat")" glob, which silently made
+rem  zero iterations under console codepage 65001 on some Windows
+rem  builds -> ".bat стратегии не найдены в движке" even though the
+rem  files were on disk. The listing is now done by lib\profiles.ps1
+rem  (Get-ChildItem - the same call check.ps1 uses successfully).
+rem  Each line of its output is "<file>.bat|<arguments>", so PROFILE_N
+rem  keeps holding the real file name (with .bat) exactly as before.
+rem ============================================================
 :pickstrategy
 set "DSTRAT="
 for /f "usebackq delims=" %%A in (`powershell -NoProfile -ExecutionPolicy Bypass -File lib\config.ps1 get -Key default_strategy`) do set "DSTRAT=%%A"
@@ -83,15 +93,13 @@ echo.
 echo  Выбери стратегию по умолчанию (она станет автоматической):
 echo.
 set /a N=0
-for %%F in ("%ZEYE_ENGINE%\*.bat") do (
-    rem skip helper scripts that are not strategies (same rule as check.ps1)
-    if /i not "%%~nxF"=="service.bat" if /i not "%%~nxF"=="uninstall_service.bat" if /i not "%%~nxF"=="update.bat" if /i not "%%~nxF"=="check.bat" (
-        set /a N+=1
-        set "PROFILE_!N!=%%~nxF"
-        echo    !N!. %%~nxF
-    )
+for /f "usebackq tokens=1* delims=|" %%F in (`powershell -NoProfile -ExecutionPolicy Bypass -File lib\profiles.ps1`) do (
+    set /a N+=1
+    set "PROFILE_!N!=%%F"
+    set "ARGS_!N!=%%G"
+    if not "%%G"=="" (echo    !N!. %%F  [%%G]) else (echo    !N!. %%F)
 )
-if %N%==0 ( echo  [zeye] .bat стратегии не найдены в движке. & pause & goto :header )
+if "%N%"=="0" ( echo  [zeye] .bat стратегии не найдены в движке. & pause & goto :header )
 echo.
 set "SEL="
 set /p "SEL=  Номер: "
